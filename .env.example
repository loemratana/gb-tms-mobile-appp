# Copy to `.env` (gitignored) and adjust. Restart `npx expo start` after changing values.
# EXPO_PUBLIC_* values are bundled into the app — never put secrets here.

# Full API base URL. Leave empty in development to auto-detect your machine's LAN IP
# (works on physical devices and emulators). Required for preview/production builds.
EXPO_PUBLIC_API_URL=

# Used only when EXPO_PUBLIC_API_URL is empty (development auto-detect).
EXPO_PUBLIC_API_PORT=8080
EXPO_PUBLIC_API_PATH=/api/v1

