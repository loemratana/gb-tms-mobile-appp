{
  "expo": {
    "name": "tmsmobileapp",
    "slug": "tmsmobileapp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "tmsmobileapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "com.ratana.taskmanagement",
      "googleServicesFile": "./GoogleService-Info.plist",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "NSSpeechRecognitionUsageDescription": "Allow TMS to convert your voice into text.",
        "NSMicrophoneUsageDescription": "Allow TMS to use your microphone for voice-to-text."
      }
    },
    "android": {
      "package": "com.ratana.taskmanagement",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Allow TMS to use your microphone for voice-to-text.",
          "speechRecognitionPermission": "Allow TMS to convert your voice into text."
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-speech-recognition",
      "@react-native-firebase/app",
      "@react-native-firebase/messaging",
      "expo-notifications",
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static"
          }
        }
      ],
      "expo-audio",
      "expo-asset",
      "expo-font",
      "expo-image",
      "expo-status-bar",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiUrl": "http://localhost:8080/api/v1",
      "router": {},
      "eas": {
        "projectId": "56109fbb-e37d-4268-9bac-cb2d9e60d9c4"
      }
    }
  }
}
